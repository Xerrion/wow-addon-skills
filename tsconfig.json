{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noEmitOnError": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowJs": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": ["mcp/**/*.ts", "mcp/**/*.mjs"],
  "exclude": ["**/*.test.*"]
}
